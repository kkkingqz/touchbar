# Example user profile document for GNOME. Copy it to
# ~/.config/touchbar/profiles.toml. Copy config/profiles-gnome/*.toml.example
# into ~/.config/touchbar/profiles-gnome/, removing the .example suffix.
# touchbar-sessiond reloads the root and fragments on change.
#
# It needs the session daemon's --gnome-context and --media-context (the user
# unit passes both), the Window Monitor Pro GNOME Shell extension for
# application.id, and the first-party Media, System Controls and App Actions
# packs installed. Every item is `required = false`, so the document stays
# valid with any of them missing.
#
# application.id is the focused window's WM class from Window Monitor Pro,
# trimmed and lowercased; the bare desktop has none. To find an application's
# class, focus it and watch `journalctl --user -u touchbar-session -f` for
# `context-event key=application.id`. Some common ones:
#   firefox_firefox (snap Firefox)   libreoffice-writer   libreoffice-calc
#   vlc                              org.gnome.ptyxis     com.mitchellh.ghostty
#
# media.* describe the now-playing session, chosen as on macOS: the player
# that most recently started playing keeps it while paused. The Media pack
# shows that same session.
#   media.player            vlc, rhythmbox, firefox (the MPRIS bus name
#                           without prefix and instance suffix)
#   media.playback-status   playing or paused
#   media.active            true while it plays and for a minute after
#
# The fallback is touchbard's trusted system row (brightness, microphone,
# search, keyboard light, media keys, volume; hold Fn for F1-F12). It shows
# whenever the active profile has no visible item, which is what `system`
# does. Like macOS's app-specific Touch Bar, the other profiles replace it
# only in their own application:
# - media: a player (VLC, Rhythmbox) while it owns the session, playing or
#   paused; Firefox while its video or audio plays, and for a minute after a
#   pause so it can be resumed;
# - browser: Firefox otherwise, with back, forward and reload;
# - office: LibreOffice Writer, Calc and Impress, with bold, italic and
#   underline.
# The browser and office buttons press the application's own shortcuts
# (keyboard.shortcut.v1, pack App Actions), and only in that application.
# Terminals and remote desktops keep the system row: F1-F12 are one Fn hold
# away.
version = 1
fallback = "system"
include = [
  "profiles-gnome/default.toml",
  "profiles-gnome/browser.toml",
  "profiles-gnome/office.toml",
  "profiles-gnome/media.toml",
]
