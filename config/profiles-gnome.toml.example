# Example user profile document for GNOME. Copy it to
# ~/.config/touchbar/profiles.toml; touchbar-sessiond reloads it on change.
#
# It needs the session daemon's --gnome-context and --media-context (the user
# unit passes both), the Window Monitor Pro GNOME Shell extension for
# application.id, and the first-party Media, System Controls and App Actions
# packs installed. Every item is `required = false`, so the document stays
# valid with any of them missing.
#
# application.id is the focused window's WM class from Window Monitor Pro,
# trimmed and lowercased; the bare desktop has none. To find an application's
# class, focus it and watch `journalctl --user -u touchbar-session -f` for
# `context-event key=application.id`. Some common ones:
#   firefox_firefox (snap Firefox)   libreoffice-writer   libreoffice-calc
#   vlc                              org.gnome.ptyxis     com.mitchellh.ghostty
#
# media.* describe the now-playing session, chosen as on macOS: the player
# that most recently started playing keeps it while paused. The Media pack
# shows that same session.
#   media.player            vlc, rhythmbox, firefox (the MPRIS bus name
#                           without prefix and instance suffix)
#   media.playback-status   playing or paused
#   media.active            true while it plays and for a minute after
#
# The fallback is touchbard's trusted system row (brightness, microphone,
# search, keyboard light, media keys, volume; hold Fn for F1-F12). It shows
# whenever the active profile has no visible item, which is what `system`
# does. Like macOS's app-specific Touch Bar, the other profiles replace it
# only in their own application:
# - media: a player (VLC, Rhythmbox) while it owns the session, playing or
#   paused; Firefox while its video or audio plays, and for a minute after a
#   pause so it can be resumed;
# - browser: Firefox otherwise, with back, forward and reload;
# - office: LibreOffice Writer, Calc and Impress, with bold, italic and
#   underline.
# The browser and office buttons press the application's own shortcuts
# (keyboard.shortcut.v1, pack App Actions), and only in that application.
# Terminals and remote desktops keep the system row: F1-F12 are one Fn hold
# away.
version = 1
fallback = "system"

[[contribution]]
id = "transport"
items = [
  { plugin = "github:cameroncooper/touchbar-media", item = "transport", required = false },
]

[[contribution]]
id = "timeline"
items = [
  { plugin = "github:cameroncooper/touchbar-media", item = "timeline", required = false },
]

[[contribution]]
id = "browser"
items = [
  { plugin = "github:cameroncooper/touchbar-app-actions", item = "browser", required = false },
]

[[contribution]]
id = "formatting"
items = [
  { plugin = "github:cameroncooper/touchbar-app-actions", item = "formatting", required = false },
]

[[contribution]]
id = "volume"
items = [
  { plugin = "github:cameroncooper/touchbar-controls", item = "volume", required = false },
]

[[contribution]]
id = "brightness"
items = [
  { plugin = "github:cameroncooper/touchbar-controls", item = "brightness", required = false },
]

# No visible item, so touchbard's system row shows.
[[profile]]
id = "system"

[[profile.element]]
kind = "flexible-space"
minimum = 0
weight = 1

# macOS's Now Playing layout: previous, play/pause and next, then the title
# and artist over a scrubber with elapsed and remaining time. The volume and
# display brightness sliders on the right stand in for the Control Strip;
# they set absolute levels and show a default position until first touched.
[[profile]]
id = "media"

[[profile.element]]
kind = "slot"
id = "transport"
policy = "fixed"
contributions = ["transport"]

[[profile.element]]
kind = "fixed-space"
width = 12

[[profile.element]]
kind = "slot"
id = "timeline"
policy = "fixed"
contributions = ["timeline"]

[[profile.element]]
kind = "flexible-space"
minimum = 16
weight = 1

[[profile.element]]
kind = "group"
id = "levels"
layout = "equal-width"
spacing = 8

[[profile.element.element]]
kind = "slot"
id = "volume"
policy = "fixed"
contributions = ["volume"]

[[profile.element.element]]
kind = "slot"
id = "brightness"
policy = "fixed"
contributions = ["brightness"]

# Safari's layout: navigation on the left; the volume and display brightness
# sliders on the right stand in for the Control Strip, as in media.
[[profile]]
id = "browser"

[[profile.element]]
kind = "slot"
id = "browser"
policy = "fixed"
contributions = ["browser"]

[[profile.element]]
kind = "flexible-space"
minimum = 16
weight = 1

[[profile.element]]
kind = "group"
id = "levels"
layout = "equal-width"
spacing = 8

[[profile.element.element]]
kind = "slot"
id = "volume"
policy = "fixed"
contributions = ["volume"]

[[profile.element.element]]
kind = "slot"
id = "brightness"
policy = "fixed"
contributions = ["brightness"]

# Pages' and Word's text formatting buttons, then the same Control Strip.
[[profile]]
id = "office"

[[profile.element]]
kind = "slot"
id = "formatting"
policy = "fixed"
contributions = ["formatting"]

[[profile.element]]
kind = "flexible-space"
minimum = 16
weight = 1

[[profile.element]]
kind = "group"
id = "levels"
layout = "equal-width"
spacing = 8

[[profile.element.element]]
kind = "slot"
id = "volume"
policy = "fixed"
contributions = ["volume"]

[[profile.element.element]]
kind = "slot"
id = "brightness"
policy = "fixed"
contributions = ["brightness"]

# Players, whenever they own the session.
[[rule]]
profile = "media"
priority = 100
when = { kind = "any", predicates = [
  { kind = "all", predicates = [
    { kind = "text-equals", key = "application.id", value = "vlc" },
    { kind = "text-equals", key = "media.player", value = "vlc" },
  ] },
  # Rhythmbox's class may be its GTK application ID or its executable name;
  # both are listed.
  { kind = "all", predicates = [
    { kind = "any", predicates = [
      { kind = "text-equals", key = "application.id", value = "org.gnome.rhythmbox3" },
      { kind = "text-equals", key = "application.id", value = "rhythmbox" },
    ] },
    { kind = "text-equals", key = "media.player", value = "rhythmbox" },
  ] },
] }

# Firefox (snap), while its own media plays and for a minute after a pause.
[[rule]]
profile = "media"
priority = 90
when = { kind = "all", predicates = [
  { kind = "text-equals", key = "application.id", value = "firefox_firefox" },
  { kind = "text-equals", key = "media.player", value = "firefox" },
  { kind = "boolean-equals", key = "media.active", value = true },
] }

# Firefox without active media. Below the media rule, which takes over while
# a video or song plays in it.
[[rule]]
profile = "browser"
priority = 50
when = { kind = "text-equals", key = "application.id", value = "firefox_firefox" }

# LibreOffice Writer, Calc and Impress.
[[rule]]
profile = "office"
priority = 50
when = { kind = "any", predicates = [
  { kind = "text-equals", key = "application.id", value = "libreoffice-writer" },
  { kind = "text-equals", key = "application.id", value = "libreoffice-calc" },
  { kind = "text-equals", key = "application.id", value = "libreoffice-impress" },
] }
