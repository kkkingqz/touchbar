{
  "capture": {
    "items": [
      {
        "id": "screenshots",
        "label": "Screenshots",
        "expanded_bar": "capture-palette"
      },
      {
        "id": "recording",
        "label": "Recording"
      },
      {
        "id": "capture-tools",
        "label": "Capture Tools"
      }
    ],
    "bar": [
      {
        "id": "capture-palette",
        "minimum_width": 240,
        "preferred_width": 480,
        "maximum_width": 720,
        "dismiss_on_selection": true,
        "principal_item": "screenshots",
        "element": [
          {
            "kind": "item",
            "item": "screenshots",
            "minimum_width": 80,
            "preferred_width": 160,
            "maximum_width": 240
          },
          {
            "kind": "item",
            "item": "recording",
            "minimum_width": 80,
            "preferred_width": 160,
            "maximum_width": 240
          },
          {
            "kind": "item",
            "item": "capture-tools",
            "minimum_width": 80,
            "preferred_width": 160,
            "maximum_width": 240
          }
        ]
      }
    ],
    "profile": [],
    "permission": [
      {
        "capability": "local.connect.v1",
        "required": false,
        "reason": "Send structured capture actions to an explicitly bound user-owned service",
        "scope": {
          "maximum_frame_bytes": 4096,
          "maximum_bytes_per_minute": 65536,
          "endpoints": [
            {
              "label": "capture",
              "protocol": "io.github.cameroncooper.touchbar.capture.v1",
              "suggested_endpoint": "$XDG_RUNTIME_DIR/touchbar/capture.sock"
            }
          ]
        }
      }
    ],
    "appearance-provider": []
  },
  "hyprland": {
    "items": [
      {
        "id": "workspaces",
        "label": "Workspaces",
        "expanded_bar": "workspace-actions"
      },
      {
        "id": "window-actions",
        "label": "Window Actions"
      },
      {
        "id": "move-window",
        "label": "Move Window"
      }
    ],
    "bar": [
      {
        "id": "workspace-actions",
        "minimum_width": 428,
        "preferred_width": 840,
        "maximum_width": 1004,
        "dismiss_on_selection": true,
        "principal_item": "workspaces",
        "element": [
          {
            "kind": "item",
            "item": "workspaces",
            "minimum_width": 180,
            "preferred_width": 360,
            "maximum_width": 520
          },
          {
            "kind": "fixed-space",
            "width": 8
          },
          {
            "kind": "item",
            "item": "window-actions",
            "minimum_width": 120,
            "preferred_width": 220,
            "maximum_width": 280
          },
          {
            "kind": "item",
            "item": "move-window",
            "minimum_width": 120,
            "preferred_width": 240,
            "maximum_width": 320
          }
        ]
      }
    ],
    "profile": [],
    "permission": [
      {
        "capability": "context.read.v1",
        "required": false,
        "reason": "Adapt controls to the focused application and active workspace",
        "scope": {
          "facts": [
            "application.id",
            "workspace.id"
          ],
          "maximum_updates_per_second": 10
        }
      },
      {
        "capability": "command.run.v1",
        "required": false,
        "reason": "Send narrowly templated dispatches to the running Hyprland session",
        "scope": {
          "maximum_parallel_processes": 1,
          "commands": [
            {
              "id": "workspace",
              "executable": "/usr/bin/hyprctl",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "dispatch"
                },
                {
                  "kind": "literal",
                  "value": "workspace"
                },
                {
                  "kind": "bounded-integer",
                  "name": "workspace",
                  "minimum": 1,
                  "maximum": 10
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 1000
            },
            {
              "id": "move-window",
              "executable": "/usr/bin/hyprctl",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "dispatch"
                },
                {
                  "kind": "literal",
                  "value": "movetoworkspace"
                },
                {
                  "kind": "bounded-integer",
                  "name": "workspace",
                  "minimum": 1,
                  "maximum": 10
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 1000
            },
            {
              "id": "fullscreen",
              "executable": "/usr/bin/hyprctl",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "dispatch"
                },
                {
                  "kind": "literal",
                  "value": "fullscreen"
                },
                {
                  "kind": "literal",
                  "value": "1"
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 1000
            },
            {
              "id": "toggle-float",
              "executable": "/usr/bin/hyprctl",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "dispatch"
                },
                {
                  "kind": "literal",
                  "value": "togglefloating"
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 1000
            }
          ]
        }
      }
    ],
    "appearance-provider": []
  },
  "command-deck": {
    "items": [
      {
        "id": "quick-actions",
        "label": "Quick Actions",
        "expanded_bar": "quick-actions-expanded"
      },
      {
        "id": "launchers",
        "label": "Launchers"
      },
      {
        "id": "session",
        "label": "Session Actions"
      },
      {
        "id": "custom-actions",
        "label": "Custom Actions"
      }
    ],
    "bar": [
      {
        "id": "quick-actions-expanded",
        "minimum_width": 408,
        "preferred_width": 720,
        "maximum_width": 1004,
        "dismiss_on_selection": true,
        "principal_item": "quick-actions",
        "element": [
          {
            "kind": "item",
            "item": "quick-actions",
            "minimum_width": 100,
            "preferred_width": 160,
            "maximum_width": 240
          },
          {
            "kind": "item",
            "item": "launchers",
            "minimum_width": 100,
            "preferred_width": 180,
            "maximum_width": 280
          },
          {
            "kind": "flexible-space",
            "minimum": 8,
            "weight": 1
          },
          {
            "kind": "item",
            "item": "session",
            "minimum_width": 100,
            "preferred_width": 160,
            "maximum_width": 240
          },
          {
            "kind": "item",
            "item": "custom-actions",
            "minimum_width": 100,
            "preferred_width": 212,
            "maximum_width": 320
          }
        ]
      }
    ],
    "profile": [],
    "permission": [
      {
        "capability": "command.run.v1",
        "required": false,
        "reason": "Launch a terminal, run a harmless diagnostic probe, and perform the guarded lock-session action",
        "scope": {
          "maximum_parallel_processes": 2,
          "commands": [
            {
              "id": "terminal",
              "executable": "/usr/bin/xdg-terminal-exec",
              "arguments": [],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 5000
            },
            {
              "id": "probe",
              "executable": "/usr/bin/printf",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "touchbar command probe\n"
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 2000
            },
            {
              "id": "lock",
              "executable": "/usr/bin/loginctl",
              "arguments": [
                {
                  "kind": "literal",
                  "value": "lock-session"
                }
              ],
              "maximum_output_bytes": 4096,
              "timeout_milliseconds": 5000
            }
          ]
        }
      },
      {
        "capability": "local.connect.v1",
        "required": false,
        "reason": "Invoke user-defined actions through an explicitly bound local Command Deck service",
        "scope": {
          "maximum_frame_bytes": 4096,
          "maximum_bytes_per_minute": 65536,
          "endpoints": [
            {
              "label": "command-deck",
              "protocol": "io.github.cameroncooper.touchbar.command-deck.v1",
              "suggested_endpoint": "$XDG_RUNTIME_DIR/touchbar/command-deck.sock"
            }
          ]
        }
      }
    ],
    "appearance-provider": []
  },
  "omarchy": {
    "items": [
      {
        "id": "screensaver",
        "label": "Screensaver",
        "default_width": 2008,
        "show_in_default_profile": false
      },
      {
        "id": "palette",
        "label": "Theme Palette",
        "show_in_default_profile": false
      }
    ],
    "bar": [],
    "profile": [
      {
        "id": "screensaver",
        "label": "Omarchy Screensaver",
        "items": [
          "screensaver"
        ],
        "principal_item": "screensaver",
        "applications": [
          "org.omarchy.screensaver"
        ],
        "activities": [
          "omarchy-image-selector",
          "theme-change"
        ]
      }
    ],
    "permission": [
      {
        "capability": "appearance.provide.v1",
        "required": true,
        "reason": "Watch Omarchy theme selection and publish its semantic Touch Bar palette",
        "scope": {
          "providers": [
            "omarchy"
          ],
          "maximum_file_bytes": 65536,
          "maximum_updates_per_second": 4,
          "mounts": [
            {
              "label": "omarchy-runtime",
              "suggested_location": "xdg-runtime:"
            },
            {
              "label": "omarchy-current",
              "suggested_location": "xdg-state:omarchy/current"
            },
            {
              "label": "omarchy-user-themes",
              "suggested_location": "xdg-config:omarchy/themes"
            },
            {
              "label": "omarchy-system-themes",
              "suggested_location": "system-data:omarchy/themes"
            }
          ]
        }
      }
    ],
    "appearance-provider": [
      {
        "id": "omarchy",
        "label": "Omarchy",
        "entrypoint": "component/appearance-provider.wasm",
        "world": "touchbar:plugin/appearance-provider@1.0.0",
        "build_package": "touchbar-omarchy-appearance-provider",
        "desktop_sessions": [
          "omarchy"
        ],
        "mounts": [
          "omarchy-runtime",
          "omarchy-current",
          "omarchy-user-themes",
          "omarchy-system-themes"
        ]
      }
    ]
  }
}
