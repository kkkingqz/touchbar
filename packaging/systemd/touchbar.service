[Unit]
Description=TouchBar hardware service
Documentation=https://github.com/cameroncooper/touchbar
Conflicts=tiny-dfr.service
After=systemd-udevd.service systemd-logind.service
BindsTo=dev-touchbar_display.device
After=dev-touchbar_display.device

[Service]
Type=simple
ExecStart=/usr/lib/touchbar/touchbard --socket /run/touchbar/hardware.sock
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillSignal=SIGTERM
RuntimeDirectory=touchbar
RuntimeDirectoryMode=0755
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateIPC=true
ProtectKernelTunables=true
# ProtectKernelTunables= makes all of /sys read-only, but the idle policy
# writes exactly one backlight attribute (backlight.rs KNOWN_NAMES). systemd
# resolves the class symlink to the device node; "-" skips absent names.
ReadWritePaths=-/sys/class/backlight/appletb_backlight/brightness
ReadWritePaths=-/sys/class/backlight/228200000.display-pipe.0/brightness
ReadWritePaths=-/sys/class/backlight/228600000.dsi.0/brightness
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
