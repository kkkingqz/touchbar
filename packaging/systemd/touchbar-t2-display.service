[Unit]
Description=Switch the T2 Touch Bar to its display configuration for touchbard
Documentation=https://github.com/cameroncooper/touchbar
# Every enumeration starts in the native configuration (90-touchbar-t2.rules).
# This unit runs at boot, after each resume (touchbar-t2-sleep.service), and
# whenever udev sees the Touch Bar enumerate again while TouchBar is active.
ConditionPathExists=/etc/touchbar/enabled
# Without default dependencies multi-user.target does not wait for the switch;
# the boot continues with the T2's own function row until it completes.
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/touchbar/touchbar-t2-mode display
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
